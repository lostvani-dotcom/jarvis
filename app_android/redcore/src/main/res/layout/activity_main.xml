<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0C0505">

    <!-- Tira de abas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0C0505"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp" />
    </HorizontalScrollView>

    <!-- Barra de ferramentas: navegação + endereço + nova aba -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_toolbar"
        android:padding="6dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textColor="#E7E5E5"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_nav_button" />

        <Button
            android:id="@+id/forwardButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="→"
            android:textColor="#E7E5E5"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_nav_button" />

        <Button
            android:id="@+id/reloadButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⟳"
            android:textColor="#E7E5E5"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_nav_button" />

        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:hint="Digite um endereço ou pesquise..."
            android:textColorHint="#8F7C7C"
            android:textColor="#FBF9F9"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:background="@drawable/bg_address_bar" />

        <Button
            android:id="@+id/newTabButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+"
            android:textSize="18sp"
            android:textColor="#FFF9F8"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_nav_button" />
    </LinearLayout>

    <!-- Conteúdo da aba ativa (a WebView é anexada aqui em runtime) -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />

</LinearLayout>
