<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <Button
        android:id="@+id/dialogDiscoverButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buscar o Ultron automaticamente"
        android:textAllCaps="false"
        android:textColor="#04201F"
        android:stateListAnimator="@null"
        android:backgroundTint="@null"
        android:background="@drawable/bg_address_bar"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/dialogHostInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="IP do PC ou URL remota"
        android:textColorHint="#8F7C7C"
        android:textColor="#1A1A1A"
        android:inputType="text"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/dialogPortInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Porta"
        android:text="8765"
        android:textColorHint="#8F7C7C"
        android:textColor="#1A1A1A"
        android:inputType="number"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/dialogTokenInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Token (config.json -&gt; servidor.token)"
        android:textColorHint="#8F7C7C"
        android:textColor="#1A1A1A"
        android:inputType="textPassword"
        android:layout_marginBottom="14dp" />

    <CheckBox
        android:id="@+id/dialogSyncHistoryCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sincronizar histórico de navegação com o Ultron do PC"
        android:textColor="#1A1A1A"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Envia URL e título de cada página visitada pro banco de dados do Ultron -- desligado por padrão."
        android:textColor="#6B6B6B"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
</ScrollView>
