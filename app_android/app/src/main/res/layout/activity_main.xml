<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_app_gradient">

    <!-- Topo: título + engrenagem de configurações (conexão/permissões
         moraram aqui antes; agora ficam numa tela própria, ver
         SettingsActivity, pra essa tela ser só o chat, como o ChatGPT). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ultron"
            android:textColor="#6FE0FF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:shadowColor="#804FD1FF"
            android:shadowRadius="14"
            android:shadowDx="0"
            android:shadowDy="0" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⚙"
            android:textSize="18sp"
            android:textColor="#C9D3E0"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />
    </LinearLayout>

    <!-- Feed do chat: uma bolha por mensagem (ver ChatAdapter), em
         vez do TextView único de antes. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="6dp" />

    <!-- Barra de entrada em formato de pílula, mic + campo + enviar,
         mesmo espírito visual do ChatGPT mobile. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:background="@drawable/bg_input_pill"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/micButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="🎤"
            android:textSize="18sp"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@android:color/transparent" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:background="@null"
            android:hint="Mensagem"
            android:textColorHint="#7C8798"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:maxLines="6"
            android:inputType="textMultiLine|textCapSentences"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="bottom"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="➤"
            android:textSize="16sp"
            android:textColor="#FFF9F8"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_primary" />
    </LinearLayout>

</LinearLayout>
