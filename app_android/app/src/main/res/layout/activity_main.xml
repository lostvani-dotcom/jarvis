<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_app_gradient">

    <!-- Topo: menu de conversas + título + engrenagem de configurações
         (conexão/permissões moraram aqui antes; agora ficam numa tela
         própria, ver SettingsActivity, pra essa tela ser só o chat,
         como o ChatGPT). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/menuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="☰"
            android:textSize="18sp"
            android:textColor="#C9D3E0"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Ultron"
            android:textColor="#6FE0FF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:shadowColor="#804FD1FF"
            android:shadowRadius="14"
            android:shadowDx="0"
            android:shadowDy="0" />

        <Button
            android:id="@+id/newChatButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✚"
            android:textSize="18sp"
            android:textColor="#C9D3E0"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⚙"
            android:textSize="18sp"
            android:textColor="#C9D3E0"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />
    </LinearLayout>

    <!-- Feed do chat: uma bolha por mensagem (ver ChatAdapter), em
         vez do TextView único de antes. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="6dp" />

    <!-- Barra de entrada em formato de pílula, mic + campo + enviar,
         mesmo espírito visual do ChatGPT mobile. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:background="@drawable/bg_input_pill"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/micButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="🎤"
            android:textSize="18sp"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@android:color/transparent" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:background="@null"
            android:hint="Mensagem"
            android:textColorHint="#7C8798"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:maxLines="6"
            android:inputType="textMultiLine|textCapSentences"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="bottom"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="➤"
            android:textSize="16sp"
            android:textColor="#FFF9F8"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_primary" />
    </LinearLayout>

</LinearLayout>

    <!-- Painel deslizante (drawer) com as conversas salvas, estilo
         sidebar do ChatGPT. Aberto pelo botão ☰ ou arrastando da borda
         esquerda; ver MainActivity.abrirOuFecharDrawer/SessionsAdapter. -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#0A0C12"
        android:paddingTop="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="Conversas"
            android:textColor="#6FE0FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionsRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/emptySessionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Suas conversas salvas aparecem aqui."
            android:textColor="#7C8798"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
