<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/bg_app_gradient">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ultron"
        android:textColor="#6FE0FF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.25"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:shadowColor="#804FD1FF"
        android:shadowRadius="14"
        android:shadowDx="0"
        android:shadowDy="0" />

    <Button
        android:id="@+id/discoverButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Buscar o Ultron automaticamente"
        android:textColor="#04201F"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        android:backgroundTint="@null"
        android:background="@drawable/bg_button_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="IP do PC ou URL remota (https://...)"
            android:inputType="text"
            android:textColorHint="#7C8798"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_input_field" />

        <EditText
            android:id="@+id/portInput"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:hint="Porta"
            android:text="8765"
            android:inputType="number"
            android:textColorHint="#7C8798"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_input_field" />
    </LinearLayout>

    <EditText
        android:id="@+id/tokenInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Token (config.json -&gt; servidor.token)"
        android:inputType="textPassword"
        android:textColorHint="#7C8798"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_input_field" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Salvar e testar"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <Button
            android:id="@+id/notificationAccessButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Notificações"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <Button
            android:id="@+id/usageAccessButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Acesso ao uso"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card">

        <TextView
            android:id="@+id/chatLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textColor="#E5E7EB"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/micButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="🎤"
            android:textSize="20sp"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="Mensagem, ou /comando pra executar direto (ex: /abrir youtube)"
            android:textColorHint="#7C8798"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_input_field" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Enviar"
            android:textColor="#04201F"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_primary" />
    </LinearLayout>

</LinearLayout>
