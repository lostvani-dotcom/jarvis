<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="22dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="←"
                android:textColor="#E5E7EB"
                android:stateListAnimator="@null"
                android:backgroundTint="@null"
                android:background="@drawable/bg_button_secondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Configurações"
                android:textColor="#6FE0FF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONEXÃO COM O ULTRON"
            android:textColor="#7C8798"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/discoverButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Buscar o Ultron automaticamente"
            android:textColor="#04201F"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_primary" />

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="IP do PC ou URL remota (https://...)"
            android:inputType="text"
            android:textColorHint="#7C8798"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/portInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Porta"
            android:text="8765"
            android:inputType="number"
            android:textColorHint="#7C8798"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Token (config.json -&gt; servidor.token)"
            android:inputType="textPassword"
            android:textColorHint="#7C8798"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar e testar"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERMISSÕES"
            android:textColor="#7C8798"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/notificationAccessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Notificações"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <Button
            android:id="@+id/usageAccessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="Acesso ao uso"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONVERSA NA NUVEM"
            android:textColor="#7C8798"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/cloudStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="#C9D3E0"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/cloudSyncButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Sincronizar agora"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <Button
            android:id="@+id/cloudForgetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="Esquecer conversa da nuvem"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOZ E ROSTO (NO ULTRON DO PC)"
            android:textColor="#7C8798"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Precisa do Ultron do PC alcançável (mesma Wi-Fi ou túnel remoto) -- é lá que o processamento acontece."
            android:textColor="#7C8798"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/recordVoiceSampleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Gravar amostra de voz (clonagem)"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <Button
            android:id="@+id/identifyFaceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Identificar rosto pela câmera"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <TextView
            android:id="@+id/faceResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="#C9D3E0"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="28dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXTRAS"
            android:textColor="#7C8798"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/screenViewButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Ver a tela do PC"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <Button
            android:id="@+id/hardwareShortcutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Ativação por hardware (3x volume)"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Depois de tocar acima, ative &quot;Ultron (atalho de volume)&quot; na lista de serviços de acessibilidade. 3 toques seguidos no botão de baixar volume abrem o app já ouvindo."
            android:textColor="#7C8798"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/statsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Estatísticas de uso"
            android:textColor="#E5E7EB"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary" />

        <TextView
            android:id="@+id/statsResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="#C9D3E0"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
